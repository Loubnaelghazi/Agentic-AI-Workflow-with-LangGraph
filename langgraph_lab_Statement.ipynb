      "Hello! How can I help you today?\n"
     ]
    }
   ],
   "source": [
    "from langchain_ollama import ChatOllama\n",
    "\n",
    "llm = ChatOllama(\n",
    "    model=\"qwen3.5:4b\",\n",
    "    base_url=\"http://localhost:11434\",\n",
    "    temperature=0,\n",
    "    reasoning=False,\n",
    "    num_ctx=8192,\n",
    ")\n",
    "\n",
    "print(llm.invoke(\"Say hello in one short sentence.\").content)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fe51e61a",
   "metadata": {},
   "source": [
    "### Exercise 4 — Create an LLM node"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "ab816cee",
   "metadata": {},
   "outputs": [],
   "source": [
    "class AgentState(TypedDict):\n",
    "    message: str\n",
    "    response: str\n",
    "\n",
    "def chatbot(state: AgentState):\n",
    "    response = llm.invoke(state[\"message\"])\n",
    "    return {\"response\": response.content}\n",
    "\n",
    "graph_builder = StateGraph(AgentState)\n",
    "graph_builder.add_node(\"chatbot\", chatbot)\n",
    "graph_builder.add_edge(START, \"chatbot\")\n",
    "graph_builder.add_edge(\"chatbot\", END)\n",
    "\n",
    "graph = graph_builder.compile()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "5a81b21e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Artificial intelligence is a branch of computer science dedicated to creating systems capable of performing tasks that typically require human intelligence, such as learning, reasoning, and problem-solving. These systems utilize algorithms and vast amounts of data to identify patterns and make decisions or predictions with minimal human intervention. Ultimately, AI aims to augment human capabilities by automating complex processes and providing insights that drive innovation across various industries.\n"
     ]
    }
   ],
   "source": [
    "result = graph.invoke({\n",
