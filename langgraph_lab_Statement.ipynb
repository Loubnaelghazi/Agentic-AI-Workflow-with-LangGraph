      "```python\n",
      "def factorial(n):\n",
      "    \"\"\"\n",
      "    Computes the factorial of n iteratively.\n",
      "    \n",
      "    Args:\n",
      "        n (int): A non-negative integer.\n",
      "        \n",
      "    Returns:\n",
      "        int: The factorial of n.\n",
