    "    - mathematics\n",
    "    - programming\n",
    "    - artificial_intelligence\n",
    "\n",
    "    Question:\n",
    "    {state['question']}\n",
    "\n",
    "    Return only the category.\n",
    "    \"\"\"\n",
    "    response = llm.invoke(prompt)\n",
    "    return {\"category\": response.content.strip().lower()}"
