    "## PART IX — Memory\n",
    "### Exercise 9 — Conversational state\n",
    "\n",
    "The `add_messages` reducer **appends** new messages to the list instead of overwriting it."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "a930bf58",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<langgraph.graph.state.StateGraph at 0x7127e28d5150>"
      ]
     },
     "execution_count": 29,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "from typing import Annotated\n",
    "from langgraph.graph.message import add_messages\n",
    "\n",
    "class ChatState(TypedDict):\n",
    "    messages: Annotated[list, add_messages]\n",
    "\n",
    "def chatbot(state: ChatState):\n",
    "    response = llm.invoke(state[\"messages\"])\n",
    "    return {\"messages\": [response]}\n",
    "\n",
    "chat_builder = StateGraph(ChatState)\n",
    "chat_builder.add_node(\"chatbot\", chatbot)\n",
    "chat_builder.add_edge(START, \"chatbot\")\n",
    "chat_builder.add_edge(\"chatbot\", END)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "67249bbf",
   "metadata": {},
   "source": [
    "**Without a checkpointer**, each `invoke` starts from scratch. **With a checkpointer** (`MemorySaver`) and a `thread_id`, the conversation persists between calls."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "f4997321",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WITHOUT memory: I don't have access to your personal information, including your name. As an AI assistant, I respect and protect user privacy. If you'd like to share your name with me, feel free to tell me! 😊\n"
     ]
    }
   ],
   "source": [
    "# 1) No persistence: the agent forgets\n",
    "no_memory_graph = chat_builder.compile()\n",
    "no_memory_graph.invoke({\"messages\": [(\"user\", \"My name is Ahmed.\")]})\n",
    "r = no_memory_graph.invoke({\"messages\": [(\"user\", \"What is my name?\")]})\n",
    "print(\"WITHOUT memory:\", r[\"messages\"][-1].content)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "3b59c27d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Agent: Hello Ahmed! It's nice to meet you. How can I help you today?\n",
      "Agent: Your name is **Ahmed**.\n",
      "Other thread: I don't have access to your personal information, including your name. As an AI assistant, I respect and protect user privacy. If you'd like to share your name with me, feel free to tell me! 😊\n"
     ]
    }
   ],
   "source": [
    "from langgraph.checkpoint.memory import MemorySaver\n",
    "\n",
    "# 2) With persistence: the agent remembers within the same thread\n",
    "memory_graph = chat_builder.compile(checkpointer=MemorySaver())\n",
    "config = {\"configurable\": {\"thread_id\": \"ahmed-1\"}}\n",
    "\n",
    "r1 = memory_graph.invoke({\"messages\": [(\"user\", \"My name is Ahmed.\")]}, config)\n",
    "print(\"Agent:\", r1[\"messages\"][-1].content)\n",
    "\n",
    "r2 = memory_graph.invoke({\"messages\": [(\"user\", \"What is my name?\")]}, config)\n",
    "print(\"Agent:\", r2[\"messages\"][-1].content)\n",
    "\n",
    "# A different thread has its own, separate memory\n",
    "other = {\"configurable\": {\"thread_id\": \"someone-else\"}}\n",
    "r3 = memory_graph.invoke({\"messages\": [(\"user\", \"What is my name?\")]}, other)\n",
    "print(\"Other thread:\", r3[\"messages\"][-1].content)"
   ]
  },
