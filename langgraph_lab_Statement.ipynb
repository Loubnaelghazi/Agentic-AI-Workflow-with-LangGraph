      "\tclassifier(classifier)\n",
      "\tfallback(fallback)\n",
      "\ttools(tools<hr/><small><em>__tools = calculator, current_datetime</em></small>)\n",
      "\tcourses_agent(courses_agent)\n",
      "\tprogramming_agent(programming_agent)\n",
      "\tmathematics_agent(mathematics_agent)\n",
      "\tadministration_agent(administration_agent)\n",
      "\tgeneral_agent(general_agent)\n",
      "\t__end__([<p>__end__</p>]):::last\n",
      "\t__start__ --> classifier;\n",
      "\tadministration_agent -.-> __end__;\n",
      "\tadministration_agent -.-> tools;\n",
      "\tclassifier -.-> administration_agent;\n",
      "\tclassifier -.-> courses_agent;\n",
      "\tclassifier -.-> fallback;\n",
      "\tclassifier -.-> general_agent;\n",
      "\tclassifier -.-> mathematics_agent;\n",
      "\tclassifier -.-> programming_agent;\n",
      "\tcourses_agent -.-> __end__;\n",
      "\tcourses_agent -.-> tools;\n",
      "\tgeneral_agent -.-> __end__;\n",
      "\tgeneral_agent -.-> tools;\n",
      "\tmathematics_agent -.-> __end__;\n",
      "\tmathematics_agent -.-> tools;\n",
      "\tprogramming_agent -.-> __end__;\n",
      "\tprogramming_agent -.-> tools;\n",
      "\ttools -.-> administration_agent;\n",
      "\ttools -.-> courses_agent;\n",
      "\ttools -.-> general_agent;\n",
      "\ttools -.-> mathematics_agent;\n",
      "\ttools -.-> programming_agent;\n",
      "\tfallback --> __end__;\n",
      "\tclassDef default fill:#f2f0ff,line-height:1.2\n",
      "\tclassDef first fill-opacity:0\n",
      "\tclassDef last fill:#bfb6fc\n",
      "\n"
     ]
    }
   ],
   "source": [
    "NODE_NAMES = {c: f\"{c.lower()}_agent\" for c in CATEGORIES}\n",
    "\n",
    "def route_after_classifier(state: AssistantState):\n",
    "    return NODE_NAMES.get(state[\"category\"], \"fallback\")\n",
    "\n",
    "def route_after_agent(state: AssistantState):\n",
    "    last = state[\"messages\"][-1]\n",
    "    return \"tools\" if getattr(last, \"tool_calls\", None) else END\n",
    "\n",
    "def route_after_tools(state: AssistantState):\n",
    "    # return to the agent that requested the tool\n",
    "    return NODE_NAMES.get(state[\"category\"], \"general_agent\")\n",
    "\n",
    "builder = StateGraph(AssistantState)\n",
    "builder.add_node(\"classifier\", classify)\n",
    "builder.add_node(\"fallback\", fallback)\n",
    "builder.add_node(\"tools\", ToolNode(tools, handle_tool_errors=True))\n",
    "for c in CATEGORIES:\n",
    "    builder.add_node(NODE_NAMES[c], make_agent(c))\n",
    "\n",
    "builder.add_edge(START, \"classifier\")\n",
    "builder.add_conditional_edges(\n",
    "    \"classifier\", route_after_classifier,\n",
    "    {**{n: n for n in NODE_NAMES.values()}, \"fallback\": \"fallback\"},\n",
    ")\n",
    "for c in CATEGORIES:\n",
    "    builder.add_conditional_edges(NODE_NAMES[c], route_after_agent, {\"tools\": \"tools\", END: END})\n",
    "builder.add_conditional_edges(\"tools\", route_after_tools, {n: n for n in NODE_NAMES.values()})\n",
    "builder.add_edge(\"fallback\", END)\n",
    "\n",
    "assistant = builder.compile(checkpointer=MemorySaver())\n",
    "show_graph(assistant)"
   ]
  },
